<!DOCTYPE html>
<html lang="id">
<head>
    <title>K-Flow Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .card { border-radius: 15px; border: none; }
        .stat-card { text-align: center; padding: 15px; }
        .stat-number { font-size: 28px; font-weight: bold; }
        .stat-label { font-size: 12px; color: #6c757d; }
    </style>
</head>
<body class="bg-light p-3">
    <div class="container" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-primary">🤖 K-Flow Dashboard</h4>
            <div>
                <span class="badge bg-success rounded-pill">Bot On</span>
                <a href="/" class="btn btn-sm btn-outline-primary ms-1">🔄</a>
            </div>
        </div>

        <!-- STATS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-primary"><%= stats.chats %></div>
                    <div class="stat-label">Chats</div>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-info"><%= stats.memories %></div>
                    <div class="stat-label">Memories</div>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-success"><%= stats.transactions %></div>
                    <div class="stat-label">Transaksi</div>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-warning"><%= stats.reminders %></div>
                    <div class="stat-label">Reminders</div>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-danger"><%= stats.stickers %></div>
                    <div class="stat-label">Stickers</div>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-secondary"><%= data.length %></div>
                    <div class="stat-label">Events</div>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="card shadow-sm stat-card">
                    <div class="stat-number text-dark"><%= stats.totalUsage %></div>
                    <div class="stat-label">Commands</div>
                </div>
            </div>
        </div>

        <!-- CHARTS -->
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card shadow-sm h-100 p-3">
                    <h6 class="text-center text-muted mb-3">Siapa Paling Boros?</h6>
                    <div style="max-height: 200px; display: flex; justify-content: center;">
                        <canvas id="chartBoros"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card shadow-sm h-100 p-3">
                    <h6 class="text-center text-muted mb-3">Top Memory Users</h6>
                    <div style="max-height: 200px; display: flex; justify-content: center;">
                        <% if (stats.memPerUser.length > 0) { %>
                            <canvas id="chartMemory"></canvas>
                        <% } else { %>
                            <p class="text-muted text-center mt-4">Belum ada data memori.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- CASHFLOW -->
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card shadow-sm h-100 p-3">
                    <h6 class="text-center text-muted mb-3">Cashflow</h6>
                    <div style="max-height: 180px; display: flex; justify-content: center;">
                        <canvas id="chartCashflow"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card shadow-sm h-100 p-3">
                    <h6 class="text-center text-muted mb-3">Top Memory Users</h6>
                    <div style="max-height: 200px; display: flex; justify-content: center;">
                        <% if (stats.memPerUser.length > 0) { %>
                            <canvas id="chartMemory"></canvas>
                        <% } else { %>
                            <p class="text-muted text-center mt-4">Belum ada data memori.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS + USAGE -->
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card shadow-sm h-100 p-3">
                    <h6 class="text-center text-muted mb-3">Quick Actions</h6>
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary shadow-sm fw-bold py-2" data-bs-toggle="modal" data-bs-target="#modalTambah">
                            ➕ Tambah Transaksi
                        </button>
                        <a href="/health" class="btn btn-outline-success btn-sm" target="_blank">💓 Health Check</a>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card shadow-sm h-100 p-3">
                    <h6 class="text-center text-muted mb-3">Top Commands</h6>
                    <div style="max-height: 200px; display: flex; justify-content: center;">
                        <% if (stats.topCommands.length > 0) { %>
                            <canvas id="chartUsage"></canvas>
                        <% } else { %>
                            <p class="text-muted text-center mt-4">Belum ada data usage.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-bold py-3">📜 Riwayat Transaksi</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead class="table-light">
                            <tr>
                                <th>Tgl</th>
                                <th>Oleh</th>
                                <th>Ket</th>
                                <th class="text-end">Nominal</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% data.forEach(d => { 
                                const rawDate = new Date(d.tanggal);
                                const isoDate = new Date(rawDate.getTime() - (rawDate.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
                            %>
                            <tr>
                                <td class="text-muted" style="font-size: 12px;">
                                    <%= rawDate.toLocaleDateString('id-ID', {day: 'numeric', month: 'short'}) %><br>
                                    <%= rawDate.toLocaleTimeString('id-ID', {hour: '2-digit', minute: '2-digit'}) %>
                                </td>
                                <td>
                                    <span class="badge <%= d.sumber == 'Tami' ? 'bg-primary' : 'bg-danger' %> bg-opacity-75">
                                        <%= d.sumber %>
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold <%= d.jenis == 'pemasukan' ? 'text-success' : 'text-danger' %>">
                                        <%= d.jenis == 'pemasukan' ? '🟢' : '🔴' %>
                                    </span> 
                                    <%= d.keterangan %>
                                </td>
                                <td class="text-end fw-bold">
                                    <%= Number(d.nominal).toLocaleString('id-ID') %>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light text-warning border" 
                                        onclick="editData('<%= d.id %>', '<%= d.jenis %>', '<%= d.nominal %>', '<%= d.keterangan %>', '<%= d.sumber %>', '<%= isoDate %>')">
                                        ✏️
                                    </button>
                                    <form method="POST" action="/hapus/<%= d.id %>" style="display:inline" onsubmit="return confirm('Hapus?')">
                                        <input type="hidden" name="password" value="<%= password %>">
                                        <button type="submit" class="btn btn-sm btn-light text-danger border ms-1">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL TAMBAH -->
    <div class="modal fade" id="modalTambah" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">➕ Input Manual</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/add" method="POST">
                    <input type="hidden" name="password" value="<%= password %>">
                    <div class="modal-body">
                        <div class="row g-2">
                            <div class="col-6 mb-2">
                                <label class="form-label small text-muted">Jenis</label>
                                <select name="jenis" class="form-select">
                                    <option value="pengeluaran">🔴 Pengeluaran</option>
                                    <option value="pemasukan">🟢 Pemasukan</option>
                                </select>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small text-muted">Nominal (Rp)</label>
                                <input type="number" name="nominal" class="form-control" required>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted">Keterangan</label>
                            <input type="text" name="keterangan" class="form-control" placeholder="Beli apa..." required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary w-100">Simpan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL EDIT -->
    <div class="modal fade" id="modalEdit" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">✏️ Edit Transaksi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/update" method="POST">
                    <input type="hidden" name="password" value="<%= password %>">
                    <div class="modal-body">
                        <input type="hidden" name="id" id="editId">
                        
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label small text-muted">Tanggal & Jam</label>
                                <input type="datetime-local" name="tanggal" id="editTanggal" class="form-control" required>
                            </div>
                            <div class="col-5">
                                <label class="form-label small text-muted">Pelaku</label>
                                <select name="sumber" id="editSumber" class="form-select">
                                    <option value="Tami">Tami</option>
                                    <option value="Dini">Dini</option>
                                    <option value="WEB">WEB</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-5">
                                <label class="form-label small text-muted">Jenis</label>
                                <select name="jenis" id="editJenis" class="form-select">
                                    <option value="pengeluaran">🔴 Keluar</option>
                                    <option value="pemasukan">🟢 Masuk</option>
                                </select>
                            </div>
                            <div class="col-7">
                                <label class="form-label small text-muted">Nominal</label>
                                <input type="number" name="nominal" id="editNominal" class="form-control" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">Keterangan</label>
                            <input type="text" name="keterangan" id="editKet" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-warning w-100 text-white fw-bold">Update Data</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const dataOrang = <%- JSON.stringify(statsOrang).replace(/</g, '\\u003c') %>;
        const dataJenis = <%- JSON.stringify(statsJenis).replace(/</g, '\\u003c') %>;
        const memPerUser = <%- JSON.stringify(stats.memPerUser).replace(/</g, '\\u003c') %>;
        const topCommands = <%- JSON.stringify(stats.topCommands).replace(/</g, '\\u003c') %>;

        // Pie (Orang)
        if (dataOrang.length > 0) {
            new Chart(document.getElementById('chartBoros'), {
                type: 'pie',
                data: {
                    labels: dataOrang.map(d => d.sumber),
                    datasets: [{ data: dataOrang.map(d => d.total), backgroundColor: ['#0d6efd', '#dc3545', '#ffc107'], hoverOffset: 4 }]
                },
                options: { plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
            });
        }

        // Donut (Cashflow)
        if (dataJenis.length > 0) {
            new Chart(document.getElementById('chartCashflow'), {
                type: 'doughnut',
                data: {
                    labels: dataJenis.map(d => d.jenis.toUpperCase()),
                    datasets: [{ data: dataJenis.map(d => d.total), backgroundColor: ['#198754', '#dc3545'], hoverOffset: 4 }]
                },
                options: { plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
            });
        }

        // Bar (Memory Users)
        if (memPerUser.length > 0) {
            new Chart(document.getElementById('chartMemory'), {
                type: 'bar',
                data: {
                    labels: memPerUser.map(d => d.user),
                    datasets: [{ data: memPerUser.map(d => d.total), backgroundColor: '#0dcaf0', borderRadius: 5 }]
                },
                options: { 
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true } }
                }
            });
        }

        // Bar (Top Commands)
        if (topCommands.length > 0) {
            new Chart(document.getElementById('chartUsage'), {
                type: 'bar',
                data: {
                    labels: topCommands.map(d => d.command),
                    datasets: [{ data: topCommands.map(d => d.total), backgroundColor: '#6f42c1', borderRadius: 5 }]
                },
                options: { 
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true } }
                }
            });
        }

        function editData(id, jenis, nominal, ket, sumber, tanggal) {
            document.getElementById('editId').value = id;
            document.getElementById('editJenis').value = jenis;
            document.getElementById('editNominal').value = nominal;
            document.getElementById('editKet').value = ket;
            document.getElementById('editSumber').value = sumber;
            document.getElementById('editTanggal').value = tanggal;
            new bootstrap.Modal(document.getElementById('modalEdit')).show();
        }
    </script>
</body>
</html>
