BOT_OWNER_NUMBERS=6289608506367,62881081132332
# Format: whatsappId1:Name1,whatsappId2:Name2
BOT_USERS=6289608506367@c.us:Tami,6283806618448@c.us:Dini

# --- SERVER ---
PORT=3000
LOG_NUMBER=62881081132332@c.us
# Dashboard password (leave empty to disable auth)
DASHBOARD_PASSWORD=

# --- DATABASE ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kflow_db
DB_CONNECTION_LIMIT=3

# --- AI (via 9router) ---
ROUTER_API_KEY=
ROUTER_URL=http://localhost:20128/v1
ROUTER_MODEL=mimo/mimo-v2.5-flash

# --- PUPPETEER ---
# Leave empty so puppeteer can auto-detect Chromium in most environments.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true
# Format: --arg1,--arg2
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--no-first-run,--no-zygote

# --- LOGGING ---
# Options: debug, info, warn, error
LOG_LEVEL=info
